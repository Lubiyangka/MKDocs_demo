{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4e2a\u4eba\u7b80\u5386","text":"<ul> <li>\ud83d\udce7 {your_student_id}@stu.hit.edu.cn </li> <li>\ud83d\udcbb github.com/Lubiyangka</li> </ul>"},{"location":"#_2","title":"\ud83c\udf93 \u6559\u80b2\u80cc\u666f","text":""},{"location":"#2022-2026","title":"\u54c8\u5c14\u6ee8\u5de5\u4e1a\u5927\u5b66 \uff5c 2022 -- 2026","text":"<p>\u672c\u79d1\u751f \u00b7 \u8f6f\u4ef6\u5de5\u7a0b - \u7efc\u6d4b\u6392\u540d\uff1a\u524d 10%</p>"},{"location":"#2026-","title":"\u54c8\u5c14\u6ee8\u5de5\u4e1a\u5927\u5b66 \uff5c 2026 -- \u81f3\u4eca","text":"<p>\u5728\u8bfb\u7814\u7a76\u751f \u00b7 \u8f6f\u4ef6\u5de5\u7a0b</p>"},{"location":"#_3","title":"\ud83d\udcd1 \u5185\u5bb9\u5bfc\u822a","text":"<ul> <li>\ud83d\udd2c \u79d1\u7814\u7ecf\u5386</li> <li>\ud83d\udc65 \u9879\u76ee\u7ecf\u5386</li> <li>\u2764\ufe0f \u83b7\u5956\u60c5\u51b5</li> </ul>"},{"location":"about/","title":"\u5173\u4e8e\u672c\u9879\u76ee","text":"<p>\u672c\u9879\u76ee\u4f7f\u7528 MkDocs \u751f\u6210\u6280\u672f\u6587\u6863\uff0c\u5e76\u901a\u8fc7 GitHub Pages \u81ea\u52a8\u90e8\u7f72\u3002  </p>"},{"location":"api/","title":"API \u53c2\u8003","text":"<p>\u8fd9\u91cc\u662f API \u53c2\u8003\u6587\u6863\u793a\u4f8b\u3002  </p>"},{"location":"awards/","title":"\u2764\ufe0f \u83b7\u5956\u60c5\u51b5","text":"\u65f6\u95f4 \u5956\u9879 2024 \u5e74 5 \u6708 Finalist\uff0cThe Mathematical Contest in Modeling\uff081.3%\uff09 2024 \u5e74 5 \u6708 \u54c8\u5c14\u6ee8\u5de5\u4e1a\u5927\u5b66 \u4f18\u79c0\u56e2\u5458 2023 \u5e74 11 \u6708\u30012024 \u5e74 5 \u6708\u30012024 \u5e74 11 \u6708 \u4e8c\u7b49\uff0c\u54c8\u5c14\u6ee8\u5de5\u4e1a\u5927\u5b66 \u4eba\u6c11\u5956\u5b66\u91d1\uff087.0%\uff09"},{"location":"guide/","title":"\u4f7f\u7528\u6307\u5357","text":"<ol> <li>\u7f16\u5199 Markdown \u6587\u6863  </li> <li>\u63d0\u4ea4\u4ee3\u7801\u5230 GitHub  </li> <li>GitHub Actions \u81ea\u52a8\u6784\u5efa\u5e76\u90e8\u7f72  </li> </ol>"},{"location":"project/","title":"\ud83d\udc65 \u9879\u76ee\u7ecf\u5386","text":""},{"location":"project/#_2","title":"\u521b\u601d\u7ae5\u516c\u4f17\u53f7","text":"<p>2023 \u5e74 7 \u6708 -- 2023 \u5e74 10 \u6708 \uff5c <code>Java</code></p> <p>\u54c8\u5de5\u5927 Werun \u5b9e\u9a8c\u5ba4\u9879\u76ee\uff0c\u5c11\u513f\u6559\u80b2\u516c\u4f17\u53f7\u5e73\u53f0\u53ca\u540e\u53f0\u7ba1\u7406\u7cfb\u7edf\u540e\u7aef\u5f00\u53d1\uff0c\u7ebf\u4e0a\u8bfe\u7a0b\u89c6\u9891\u89c2\u770b\uff0c\u9898\u76ee\u4f5c\u7b54\uff1b\u6d89\u53ca\u8bfe\u7a0b\u3001\u6821\u533a\u3001\u6559\u5e08\u7684\u540e\u53f0\u7ba1\u7406\u7cfb\u7edf</p> <p>\u6280\u672f\u6808\uff1aSpring Boot\u3001Spring Data JPA\u3001QueryDSL\u3001Gradle\u3001MySQL\u3001JWT</p> <p>\u4f5c\u4e3a\u5f00\u53d1\u7ef4\u62a4\u4eba\u5458\uff1a</p> <ul> <li>\u901a\u8fc7 JPA \u7ed3\u5408 QueryDSL\uff0c\u5229\u7528 Gradle \u81ea\u52a8\u751f\u6210\u7684\u5143\u6a21\u578b\u7c7b\uff0c\u6784\u5efa\u7c7b\u578b\u5b89\u5168\u7684\u52a8\u6001 SQL \u67e5\u8be2\uff0c\u5b9e\u73b0\u8c03\u67e5\u95ee\u5377\u7ba1\u7406\u529f\u80fd</li> <li>\u4f7f\u7528 Spring Security \u6846\u67b6\uff0c\u57fa\u4e8e RBAC \u6a21\u578b\uff0c\u8fdb\u884c\u5177\u6709\u53ef\u62d3\u5c55\u6027\u7684\u63a5\u53e3\u6743\u9650\u7ba1\u7406</li> <li>\u4fee\u6539\u5e76\u7ef4\u62a4\u8bfe\u7a0b\u8be6\u60c5\u6807\u7b7e\u67e5\u8be2\u5f02\u5e38\u5bfc\u81f4\u663e\u793a\u5df2\u5220\u9664\u6807\u7b7e\u7b49\u540e\u671f Bug</li> </ul>"},{"location":"project/#spark","title":"\u57fa\u4e8e Spark \u7535\u5546\u96f6\u552e\u5206\u6790\u7684\u5206\u5e03\u5f0f\u7cfb\u7edf","text":"<p>2024 \u5e74 7 \u6708 -- 2024 \u5e74 8 \u6708 \uff5c <code>Java</code></p> <p>\u5b9e\u8bad\u56e2\u961f\u5408\u4f5c\u9879\u76ee\uff0c\u901a\u8fc7\u4e3b\u4ece\u5f0f\u5206\u5e03\u5f0f\u96c6\u7fa4\u7cfb\u7edf\u5206\u6790\u7535\u5546\u96f6\u552e\u6570\u636e</p> <p>\u6280\u672f\u6808\uff1aHadoop\u3001HDFS\u3001Spark\u3001Scala</p> <p>\u4f5c\u4e3a\u961f\u957f\uff1a\u53c2\u4e0e\u642d\u5efa Hadoop \u5206\u5e03\u5f0f\u96c6\u7fa4\u7cfb\u7edf\uff0c\u5e76\u63a7\u5236\u4e3b\u8282\u70b9\u5728 Spark \u5927\u6570\u636e\u6846\u67b6\u4e0b\uff0c\u901a\u8fc7\u8c03\u7528 HDFS \u5206\u5e03\u5f0f\u6587\u4ef6\u7cfb\u7edf\uff0c\u6574\u5408\u96c6\u7fa4\u4e2d\u5404\u4e2a\u4ece\u8282\u70b9\u7535\u5546\u96f6\u552e\u6570\u636e</p>"},{"location":"research/","title":"\ud83d\udd2c \u79d1\u7814\u7ecf\u5386","text":""},{"location":"research/#mcm","title":"\u7f8e\u56fd\u5927\u5b66\u751f\u6570\u5b66\u5efa\u6a21\u7ade\u8d5b\uff08MCM\uff09","text":"<p>2024 \u5e74 2 \u6708 \uff5c <code>Python</code></p> <p>\u57fa\u4e8e\u957f\u77ed\u65f6\u8bb0\u5fc6\u7f51\u7edc\uff08LSTM\uff09\uff0c\u901a\u8fc7 Cell State\u3001Input Gate\u3001Forget Gate\u3001Output Gate \u5206\u522b\u6a21\u62df\u8fd0\u52a8\u5458\u7684\u6bd4\u8d5b\u72b6\u6001\uff0c\u5bf9\u8d5b\u573a\u5185\u4e0e\u6bd4\u8d5b\u60c5\u51b5\u7684\u89e3\u8bfb\uff0c\u9057\u5fd8\u5df2\u7ecf\u8fc7\u53bb\u7684\u6bd4\u8d5b\u60c5\u51b5\u548c\u5f53\u524d\u51fb\u7403\u7684\u52a8\u4f5c\uff0c\u8bbe\u8ba1 MM-LSTM\uff0c\u5efa\u6a21\u89e3\u51b3\u7f51\u7403\u6bd4\u8d5b\u4e2d\u8fd0\u52a8\u5458\u5404\u9879\u8868\u73b0\u9884\u6d4b\u5f97\u5206\u7ed3\u679c\u7684\u95ee\u9898\uff0c\u5b9e\u73b0\u5bf9\u6bd4\u8d5b\u80dc\u8d1f\u548c\u5173\u952e\u65f6\u523b\u52a8\u91cf\u8f6c\u79fb\u7684\u9ad8\u7cbe\u5ea6\u5206\u6790\u548c\u63a8\u8350\u529f\u80fd\u3002\u6700\u7ec8\u53d6\u5f97 Finalist\uff08\u7279\u7b49\u63d0\u540d\u5956\uff0c\u83b7\u5956\u7387\uff1a1.3%\uff09</p> <p>\u4f5c\u4e3a\u56e2\u961f\u7f16\u7a0b\u624b\uff0c\u53c2\u4e0e\u8bbe\u8ba1\u90e8\u5206\uff1a</p> <ul> <li>\u4f7f\u7528 Pandas \u7b49\u5de5\u5177\uff0c\u5bf9\u7f51\u7403\u6bd4\u8d5b\u6570\u636e\u8fdb\u884c\u9884\u5904\u7406</li> <li>\u57fa\u4e8e LSTM \u6a21\u578b\uff0c\u5408\u4f5c\u5b9e\u73b0 the Momentum-Long Short Term Memory (MM-LSTM) \u6a21\u578b\uff0c\u5728\u6d4b\u8bd5\u96c6\u4e2d\u53d6\u5f97 94.52% \u7684\u8fd0\u52a8\u5458\u5f97\u5206\u9884\u6d4b\u51c6\u786e\u7387</li> <li>\u4e3a\u5b9e\u73b0\u6a21\u578b\u62d3\u5c55\uff0c\u6536\u96c6\u540c\u7c7b\u4e52\u4e53\u7403\u6bd4\u8d5b\u6570\u636e</li> </ul>"}]}